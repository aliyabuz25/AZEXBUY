FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY admin/package.json admin/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy pre-built artifacts (lokal build: npm run build + admin npm run build)
COPY admin/dist ./dist

# Copy AZEXBUY frontend into dist/azexbuy
COPY dist ./dist/azexbuy

RUN mkdir -p /app/data /app/uploads/azexbuy

EXPOSE 4320

ENV NODE_ENV=production
ENV PORT=4320

CMD ["node", "dist/server.js"]