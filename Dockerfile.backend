FROM node:22-alpine AS frontend-builder

WORKDIR /frontend

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY src ./src
COPY public ./public
COPY index.html tsconfig.json vite.config.ts ./

# Build frontend dist → /frontend/dist
RUN npm run build

# ── Admin panel + backend builder ────────────────────────────────
FROM node:22-alpine AS admin-builder

WORKDIR /admin

RUN apk add --no-cache python3 make g++

COPY admin/package.json admin/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY admin/src ./src
COPY admin/vite.config.ts admin/tsconfig.json admin/index.html ./

# Build admin client (vite → dist/client) + bundle server (esbuild → dist/server.js)
RUN npm run build

# Copy AZEXBUY frontend into admin dist so server can serve it
COPY --from=frontend-builder /frontend/dist ./dist/azexbuy

# ── Production runtime ────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY admin/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund

# Copy built artifacts (server.js + client + azexbuy frontend)
COPY --from=admin-builder /admin/dist ./dist

RUN mkdir -p /app/data /app/uploads/azexbuy

EXPOSE 4320

ENV NODE_ENV=production
ENV PORT=4320

CMD ["node", "dist/server.js"]