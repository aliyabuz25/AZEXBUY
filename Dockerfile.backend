FROM node:22-alpine AS frontend-builder

WORKDIR /frontend

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund 2>&1

COPY src ./src
COPY public ./public
COPY index.html tsconfig.json vite.config.ts ./

RUN ls -la && node --version && npm --version
RUN cat package.json | grep '"build"'
RUN ./node_modules/.bin/vite --version
RUN ./node_modules/.bin/vite build

# ── Admin panel + backend builder ────────────────────────────────
FROM node:22-alpine AS admin-builder

WORKDIR /admin

RUN apk add --no-cache python3 make g++

COPY admin/package.json admin/package-lock.json ./
RUN npm ci --no-audit --no-fund 2>&1

COPY admin/src ./src
COPY admin/vite.config.ts admin/tsconfig.json admin/index.html admin/build-server.mjs ./

RUN ls -la && node --version
RUN ./node_modules/.bin/vite --version
RUN ./node_modules/.bin/vite build
RUN node build-server.mjs

# Copy AZEXBUY frontend into admin dist/azexbuy
COPY --from=frontend-builder /frontend/dist ./dist/azexbuy

# ── Production runtime ────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

COPY --from=admin-builder /admin/node_modules ./node_modules
COPY --from=admin-builder /admin/dist ./dist

RUN mkdir -p /app/data /app/uploads/azexbuy

EXPOSE 4320

ENV NODE_ENV=production
ENV PORT=4320

CMD ["node", "dist/server.js"]